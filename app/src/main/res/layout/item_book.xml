<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="book"
            type="com.example.booksapp.model.BookUiModel" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_6dp"
        android:padding="@dimen/space_8dp"
        app:cardCornerRadius="@dimen/space_8dp"
        android:elevation="@dimen/dp_10">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageCover"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_150"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/space_15dp"
                app:imageUrl="@{book.coverUrl}"/>


            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_20dp">

                <TextView
                    android:id="@+id/titleText"
                    android:text="@{book.title}"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/authorText"
                    app:authorList="@{book.authorNames}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/dp_10"
                    android:textColor="@android:color/darker_gray"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>